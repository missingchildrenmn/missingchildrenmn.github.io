{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/app/**",
              "components/core/**",
              "components/site/**",
              "ui_kits/kidsidkit/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Open Sans|Jost))/i]",
        "message": "Font not provided by the design system. Available: Open Sans, Jost."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|message|confirmPrompt|cancelPrompt|open|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: header, message, confirmPrompt, cancelPrompt, open, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|groups|active|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<AppMenu> doesn't accept that prop. Declared props: title, groups, active, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppToolbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onMenu|trailing|style|key|ref|className|style|children)$/]",
        "message": "<AppToolbar> doesn't accept that prop. Declared props: title, onMenu, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BusyOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:show|message|key|ref|className|style|children)$/]",
        "message": "<BusyOverlay> doesn't accept that prop. Declared props: show, message."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|block|disabled|href|icon|children|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, block, disabled, href, icon, children, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|save|back|secondary|danger|clear|icon)$/]",
        "message": "<Button> variant must be one of 'primary' | 'save' | 'back' | 'secondary' | 'danger' | 'clear' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChildCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|age|birthday|aliases|photo|onOpen|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<ChildCard> doesn't accept that prop. Declared props: name, age, birthday, aliases, photo, onOpen, onRemove, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|actions|children|style|key|ref|className|style|children)$/]",
        "message": "<ContentCard> doesn't accept that prop. Declared props: title, subtitle, actions, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditBool'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<EditBool> doesn't accept that prop. Declared props: label, checked, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditText'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|multiline|rows|type|onChange|style|key|ref|className|style|children)$/]",
        "message": "<EditText> doesn't accept that prop. Declared props: label, value, placeholder, multiline, rows, type, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditText'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|password|tel|email|date)$/]",
        "message": "<EditText> type must be one of 'text' | 'password' | 'tel' | 'email' | 'date'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|base|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|spacing|style|key|ref|className|style|children)$/]",
        "message": "<LinkList> doesn't accept that prop. Declared props: items, spacing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkList'] > JSXAttribute[name.name='spacing'] > Literal[value!=/^(?:touch|inline)$/]",
        "message": "<LinkList> spacing must be one of 'touch' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|base|alt|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, base, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:teal|teal2x|mono|white|app)$/]",
        "message": "<Logo> variant must be one of 'teal' | 'teal2x' | 'mono' | 'white' | 'app'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|height|style|key|ref|className|style|children)$/]",
        "message": "<PageBanner> doesn't accept that prop. Declared props: src, alt, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|style|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinPad'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|digits|filled|hint|focusIndex|children|style|key|ref|className|style|children)$/]",
        "message": "<PinPad> doesn't accept that prop. Declared props: title, subtitle, digits, filled, hint, focusIndex, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|title|href|excerpt|style|key|ref|className|style|children)$/]",
        "message": "<PostListItem> doesn't accept that prop. Declared props: date, title, href, excerpt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|email|links|description|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: title, email, links, description, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|current|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: title, links, current, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
